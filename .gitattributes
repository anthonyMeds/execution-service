# Normaliza fim de linha. Sem isto, um clone no Windows marca o repositorio
# inteiro como modificado so por CRLF -- foi o que aconteceu no techchallenge,
# onde ~196 arquivos apareciam alterados sem ninguem ter tocado neles.
* text=auto

*.sh    text eol=lf
mvnw    text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.jar   binary
*.png   binary
*.jpg   binary
