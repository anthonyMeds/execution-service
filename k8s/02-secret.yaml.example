# Copie para 02-secret.yaml, preencha e NAO commite: o .gitignore ja bloqueia
# qualquer arquivo *-secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: execution-secret
  namespace: oficina
type: Opaque
stringData:
  # Connection string do MongoDB Atlas (free tier M0).
  MONGODB_URI: "mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/oficina_execution?retryWrites=true&w=majority"

  # As mesmas credenciais do rabbitmq-secret criado pelo oficina-kubernets.
  RABBITMQ_USER: "oficina"
  RABBITMQ_PASSWORD: "TROQUE_ESTA_SENHA"
