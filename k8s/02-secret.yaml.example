# OPCIONAL. So e preciso para usar o MongoDB Atlas em vez do MongoDB do cluster.
# Copie para 02-secret.yaml, preencha e NAO commite: o .gitignore bloqueia
# qualquer *-secret.yaml.
#
# O usuario e a senha do RabbitMQ NAO ficam aqui: o Deployment le direto do
# rabbitmq-secret, criado pelo pipeline do OS Service.
apiVersion: v1
kind: Secret
metadata:
  name: execution-secret
  namespace: oficina
type: Opaque
stringData:
  MONGODB_URI: "mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/oficina_execution?retryWrites=true&w=majority"
